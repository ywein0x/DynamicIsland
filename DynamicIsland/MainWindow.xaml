<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island"
        Width="460" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="SF Pro Display, Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <!-- Theme brushes: dark defaults, replaced at runtime by Theme.Apply -->
        <SolidColorBrush x:Key="IslandBg" Color="#000000" />
        <SolidColorBrush x:Key="Fg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#8E8E93" />
        <SolidColorBrush x:Key="SubtleFg" Color="#C7C7CC" />
        <SolidColorBrush x:Key="TrackBrush" Color="#3A3A3C" />
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#2C2C2E" />
        <SolidColorBrush x:Key="ClipBg" Color="#1C1C1E" />
        <SolidColorBrush x:Key="ClipHover" Color="#2C2C2E" />
        <Color x:Key="AccentColor">#64D2FF</Color>
        <SolidColorBrush x:Key="Accent" Color="#64D2FF" />
        <SolidColorBrush x:Key="AccentBar" Color="#FFFFFF" />

        <!-- Accent colors are the same in both themes, like iOS -->
        <SolidColorBrush x:Key="Green" Color="#30D158" />
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A" />
        <SolidColorBrush x:Key="OrangeDim" Color="#4DFF9F0A" />
        <SolidColorBrush x:Key="Blue" Color="#0A84FF" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Rounded, filled glyphs drawn like SF Symbols -->
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource Fg}" />
            <Setter Property="Stroke" Value="{DynamicResource Fg}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" Padding="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.8" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.8" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row in the clipboard history list -->
        <Style x:Key="ClipItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{DynamicResource ClipBg}" CornerRadius="10" Height="32" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ClipHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card on the home menu -->
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ClipBg}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <!-- Day in the month view -->
        <Style x:Key="CalendarDay" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="30" Height="30">
                            <Ellipse x:Name="Hover" Fill="{DynamicResource ClipHover}" Opacity="0" />
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.4" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Back to the home menu" link -->
        <Style x:Key="BackLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel x:Name="Root" Orientation="Horizontal" Background="Transparent">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76B;" FontSize="10" VerticalAlignment="Center" Margin="0,1,5,0" />
                            <TextBlock Text="Ana menü" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Timer length on the home menu -->
        <Style x:Key="HomeChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{DynamicResource ClipBg}" CornerRadius="14" Padding="10,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Orange}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless text input -->
        <Style x:Key="PlainInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text button ("Temizle") -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Blue}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Root" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Drop target for the file shelf. Only hit-testable while a mouse button is held,
             so normal clicks on browser tabs always go through. -->
        <Border x:Name="DropZone" Width="300" Height="56"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#01000000" AllowDrop="True" Visibility="Collapsed"
                DragEnter="Shelf_DragEnter" DragOver="Shelf_DragOver" DragLeave="Shelf_DragLeave" Drop="Shelf_Drop" />

        <!-- Second live activity, shown as a small circle beside the island (like iOS) -->
        <Border x:Name="Bubble" Width="37" Height="37" CornerRadius="18.5"
                Background="{DynamicResource IslandBg}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Opacity="0" Visibility="Hidden" Cursor="Hand"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale" />
                    <TranslateTransform x:Name="BubbleShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Ellipse x:Name="BubbleArtCircle" Width="25" Height="25" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="BubbleArt" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <Grid x:Name="BubbleRing" Width="20" Height="20" Visibility="Collapsed">
                    <Ellipse Stroke="{StaticResource OrangeDim}" StrokeThickness="2.5" />
                    <Path x:Name="BubbleRingArc" Stroke="{StaticResource Orange}" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
                <Grid x:Name="BubbleBattery" Width="26" Height="26" Visibility="Collapsed">
                    <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="2.5" />
                    <Path x:Name="BubbleBatteryArc" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock x:Name="BubbleBatteryText" FontSize="9.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="BubbleUsage" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="BubbleUsageName" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="BubbleUsageValue" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                </StackPanel>
                <TextBlock x:Name="BubbleIcon" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Foreground="{StaticResource Blue}" Text="&#xE896;" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border x:Name="Island"
                Background="{DynamicResource IslandBg}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Width="126" Height="37" CornerRadius="18.5"
                Opacity="0" Visibility="Hidden"
                RenderTransformOrigin="0.5,0"
                AllowDrop="True"
                DragEnter="Shelf_DragEnter" DragOver="Shelf_DragOver" DragLeave="Shelf_DragLeave" Drop="Shelf_Drop"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseLeftButtonDown="Island_MouseLeftButtonDown"
                MouseMove="Island_MouseMove"
                MouseLeftButtonUp="Island_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IslandScale" ScaleX="0.7" ScaleY="0.7" />
                    <TranslateTransform x:Name="IslandShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="Shadow" BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0" />
            </Border.Effect>

            <!-- Panels are centered on the island each frame so they stay put while it springs. -->
            <Canvas x:Name="Stage">

                <!-- Music, compact: art + song title + equalizer -->
                <Grid x:Name="CompactMedia" Width="300" Height="37" Opacity="0" IsHitTestVisible="False">
                    <Border Width="23" Height="23" CornerRadius="6" HorizontalAlignment="Left" Margin="8,0,0,0"
                            Background="{DynamicResource ArtPlaceholder}">
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush x:Name="CompactArt" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <local:Marquee x:Name="CompactTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                   VerticalAlignment="Center" Margin="40,0,46,0" />
                    <StackPanel x:Name="CompactBars" Orientation="Horizontal" Height="14"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                </Grid>

                <!-- Music, expanded: now playing card -->
                <Grid x:Name="ExpandedMedia" Width="380" Height="202" Opacity="0" IsHitTestVisible="False">
                    <!-- Faint wash of the artwork's color behind the cover, nothing more -->
                    <Border>
                        <Border.Background>
                            <RadialGradientBrush Center="0.13,0.27" GradientOrigin="0.13,0.27" RadiusX="0.42" RadiusY="0.75">
                                <GradientStop x:Name="GlowStop" Color="#00000000" Offset="0" />
                                <GradientStop x:Name="GlowMid" Color="#00000000" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Button Style="{StaticResource BackLink}" Click="Back_Click" Margin="22,14,0,0" />
                    <Grid Margin="22,38,22,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="58" Height="58" CornerRadius="14" Background="{DynamicResource ArtPlaceholder}">
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <ImageBrush x:Name="ExpandedArt" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                <local:Marquee x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                <TextBlock x:Name="ArtistText" FontSize="13" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="ExpandedBars" Grid.Column="2" Orientation="Horizontal" Height="20"
                                        VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center" />
                            <!-- Taller than the bar so it's easy to grab for seeking -->
                            <Grid x:Name="Track" Grid.Column="1" Height="14" Margin="6,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="Track_MouseLeftButtonDown"
                                  MouseMove="Track_MouseMove"
                                  MouseLeftButtonUp="Track_MouseLeftButtonUp">
                                <Border Height="5" Background="{DynamicResource TrackBrush}" CornerRadius="2.5" />
                                <Border x:Name="ProgressFill" Height="5" Width="0" HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBar}" CornerRadius="2.5" />
                            </Grid>
                            <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="11" TextAlignment="Right"
                                       Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Click="Previous_Click" Margin="0,0,26,0">
                                <Path Style="{StaticResource Glyph}" Data="M25,1 L25,15 L14,8 Z M13,1 L13,15 L2,8 Z" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="PlayPause_Click">
                                <Grid Width="22" Height="24">
                                    <Path x:Name="PlayIcon" Style="{StaticResource Glyph}" Data="M3,1 L3,23 L21,12 Z" />
                                    <Path x:Name="PauseIcon" Style="{StaticResource Glyph}" Visibility="Collapsed"
                                          Data="M3,1 H8 V23 H3 Z M14,1 H19 V23 H14 Z" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="Next_Click" Margin="26,0,0,0">
                                <Path Style="{StaticResource Glyph}" Data="M1,1 L1,15 L12,8 Z M13,1 L13,15 L24,8 Z" />
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="2" Style="{StaticResource IconButton}" Click="Heart_Click" ToolTip="Beğenilenlere ekle"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaHeart" FontFamily="{StaticResource IconFont}" Text="&#xE006;" FontSize="17" Foreground="{DynamicResource Fg}" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- Volume HUD -->
                <Grid x:Name="VolumePanel" Width="250" Height="37" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="VolumeIcon" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{DynamicResource Fg}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="17,0,0,0"
                               Text="&#xE995;" />
                    <Grid Width="160" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Border Background="{DynamicResource TrackBrush}" CornerRadius="2.5" />
                        <Border x:Name="VolumeFill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource AccentBar}" CornerRadius="2.5" />
                    </Grid>
                </Grid>

                <!-- Battery: charging and low battery share this panel -->
                <Grid x:Name="BatteryPanel" Width="290" Height="37" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="BatteryTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="BatteryText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BatteryOutline" Width="25" Height="13" BorderThickness="1.2" CornerRadius="3.5" Padding="1.5">
                                <Border x:Name="BatteryFill" Width="0" HorizontalAlignment="Left" CornerRadius="2" />
                            </Border>
                            <Border x:Name="BatteryNub" Width="2" Height="5" Margin="1,0,0,0" CornerRadius="0,1,1,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Caps Lock / Num Lock -->
                <Grid x:Name="LockPanel" Width="250" Height="37" Opacity="0" IsHitTestVisible="False">
                    <Border x:Name="LockBadge" Width="22" Height="22" CornerRadius="6" BorderBrush="{DynamicResource Fg}" BorderThickness="1.5"
                            HorizontalAlignment="Left" Margin="12,0,0,0">
                        <TextBlock x:Name="LockGlyph" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="LockName" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               VerticalAlignment="Center" Margin="44,0,0,0" />
                    <TextBlock x:Name="LockState" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" />
                </Grid>

                <!-- Generic pill: camera/mic in use, game summary, update available -->
                <Grid x:Name="InfoPanel" Width="320" Height="37" Opacity="0" IsHitTestVisible="False">
                    <Ellipse x:Name="InfoDot" Width="9" Height="9" HorizontalAlignment="Left" Margin="17,0,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="InfoIcon" FontFamily="{StaticResource IconFont}" FontSize="15"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" />
                    <TextBlock x:Name="InfoTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               VerticalAlignment="Center" Margin="40,0,0,0" />
                    <TextBlock x:Name="InfoDetail" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                               TextTrimming="CharacterEllipsis" MaxWidth="150"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                </Grid>

                <!-- System status, shown when peeking with nothing else going on -->
                <Grid x:Name="StatsPanel" Width="300" Height="37" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CpuText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                   Typography.NumeralAlignment="Tabular" Margin="5,0,18,0" MinWidth="30" />
                        <TextBlock Text="RAM" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RamText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                   Typography.NumeralAlignment="Tabular" Margin="5,0,18,0" MinWidth="30" />
                        <TextBlock x:Name="GpuLabel" Text="GPU" FontSize="11" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="GpuText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                   Typography.NumeralAlignment="Tabular" Margin="5,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Timer, compact: progress ring + remaining time -->
                <Grid x:Name="TimerCompact" Width="230" Height="37" Opacity="0" IsHitTestVisible="False">
                    <Grid x:Name="TimerRing" Width="20" Height="20" HorizontalAlignment="Left" Margin="10,0,0,0">
                        <Ellipse Stroke="{StaticResource OrangeDim}" StrokeThickness="2.5" />
                        <Path x:Name="TimerRingArc" Stroke="{StaticResource Orange}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <TextBlock x:Name="TimerDoneIcon" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Text="&#xEA8F;" Foreground="{StaticResource Orange}" Visibility="Collapsed"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" />
                    <TextBlock x:Name="TimerCompactText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Orange}"
                               Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                </Grid>

                <!-- Timer, expanded: pause/cancel + big time -->
                <Grid x:Name="TimerExpanded" Width="380" Height="146" Opacity="0" IsHitTestVisible="False">
                    <Button Style="{StaticResource BackLink}" Click="Back_Click" Margin="22,14,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,24,0,0">
                        <Button Style="{StaticResource IconButton}" Click="TimerPause_Click">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="{StaticResource OrangeDim}" />
                                <Path x:Name="TimerPauseIcon" Style="{StaticResource Glyph}" Fill="{StaticResource Orange}"
                                      Stroke="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M0,0 H5 V18 H0 Z M10,0 H15 V18 H10 Z" />
                                <Path x:Name="TimerResumeIcon" Style="{StaticResource Glyph}" Fill="{StaticResource Orange}"
                                      Stroke="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="4,0,0,0" Visibility="Collapsed" Data="M0,0 L0,18 L15,9 Z" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="TimerCancel_Click" Margin="4,0,0,0">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="{DynamicResource TrackBrush}" />
                                <Path Stroke="{DynamicResource Fg}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M0,0 L13,13 M13,0 L0,13" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,24,28,0">
                        <TextBlock Text="Zamanlayıcı" FontSize="13" Foreground="{StaticResource Orange}" TextAlignment="Right" />
                        <TextBlock x:Name="TimerBigText" FontSize="40" FontWeight="Light" Foreground="{StaticResource Orange}"
                                   Typography.NumeralAlignment="Tabular" TextAlignment="Right" Margin="0,-4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Notification banner -->
                <Grid x:Name="NotificationPanel" Width="360" Height="74" Opacity="0" IsHitTestVisible="False">
                    <Border x:Name="NotifIconBg" Width="42" Height="42" CornerRadius="11" Background="{StaticResource Blue}"
                            HorizontalAlignment="Left" Margin="16,0,0,0">
                        <Grid>
                            <TextBlock x:Name="NotifInitial" FontSize="19" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="11">
                                <Border.Background>
                                    <ImageBrush x:Name="NotifIcon" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Margin="70,0,22,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="NotifApp" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock Text="şimdi" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="NotifTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        <TextBlock x:Name="NotifBody" FontSize="12" Foreground="{DynamicResource SubtleFg}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Screenshot / copied image preview -->
                <Grid x:Name="ScreenshotPanel" Width="330" Height="74" Opacity="0" IsHitTestVisible="False">
                    <Border Width="76" Height="48" CornerRadius="8" Background="{DynamicResource ArtPlaceholder}"
                            HorizontalAlignment="Left" Margin="14,0,0,0">
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush x:Name="ShotImage" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Margin="104,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="Görüntü kopyalandı" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                        <TextBlock Text="Kaydetmek ve açmak için tıkla" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                </Grid>

                <!-- Clipboard history -->
                <Grid x:Name="ClipboardPanel" Width="380" Height="260" Opacity="0" IsHitTestVisible="False">
                    <StackPanel x:Name="ClipboardContent" VerticalAlignment="Top" Margin="20,14,20,12">
                        <Button Style="{StaticResource BackLink}" Click="Back_Click" Margin="2,0,0,8" />
                        <Grid Margin="2,0,2,12">
                            <TextBlock Text="Pano" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                            <TextBlock Text="Kopyalamak için tıkla" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="ClipList" />
                    </StackPanel>
                </Grid>

                <!-- Download progress / finished -->
                <Grid x:Name="DownloadPanel" Width="300" Height="37" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="DownloadIcon" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource Blue}" Text="&#xE896;"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" />
                    <TextBlock x:Name="DownloadName" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="40,0,118,0" />
                    <TextBlock x:Name="DownloadDetail" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                               Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                </Grid>

                <!-- File shelf, compact -->
                <Grid x:Name="ShelfCompact" Width="230" Height="37" Opacity="0" IsHitTestVisible="False">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource Blue}" Text="&#xE8B7;"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" />
                    <TextBlock x:Name="ShelfCompactText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               VerticalAlignment="Center" Margin="40,0,16,0" />
                </Grid>

                <!-- File shelf, expanded -->
                <Grid x:Name="ShelfPanel" Width="380" Height="194" Opacity="0" IsHitTestVisible="False">
                    <Button Style="{StaticResource BackLink}" Click="Back_Click" Margin="22,14,0,0" />
                    <Grid Margin="20,38,20,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,10">
                            <TextBlock Text="Raf" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                            <Button x:Name="ShelfClear" Style="{StaticResource LinkButton}" Content="Temizle"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="ShelfClear_Click" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Rectangle x:Name="ShelfDropHint" RadiusX="14" RadiusY="14" StrokeThickness="1.5"
                                       StrokeDashArray="4 3" Stroke="{DynamicResource SecondaryText}" />
                            <TextBlock x:Name="ShelfEmptyText" Text="Dosyaları buraya sürükle" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <WrapPanel x:Name="ShelfItems" Margin="8,8,8,0" />
                        </Grid>
                    </Grid>
                </Grid>


                <!-- Home menu: what's happening now, then shortcuts -->
                <Grid x:Name="HomePanel" Width="400" Height="180" Opacity="0" IsHitTestVisible="False">
                    <StackPanel x:Name="HomeContent" VerticalAlignment="Top" Margin="14,14,14,8">

                        <!-- Idle: the clock -->
                        <Border x:Name="HomeIdleCard" Style="{StaticResource HomeCard}" Padding="16,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="HomeClock" FontSize="32" FontWeight="Light" Foreground="{DynamicResource Fg}"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock x:Name="HomeDate" FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Bottom" Margin="12,0,0,7" />
                                </StackPanel>
                                <TextBlock x:Name="HomeStats" FontSize="11.5" Foreground="{DynamicResource SecondaryText}"
                                           Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Music -->
                        <Border x:Name="HomeMusicCard" Style="{StaticResource HomeCard}" Cursor="Hand" MouseLeftButtonUp="HomeMusic_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource ArtPlaceholder}">
                                    <Border CornerRadius="10">
                                        <Border.Background>
                                            <ImageBrush x:Name="HomeArt" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="HomeTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HomeArtist" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButton}" Click="Heart_Click" ToolTip="Beğenilenlere ekle">
                                        <TextBlock x:Name="HomeHeart" FontFamily="{StaticResource IconFont}" Text="&#xE006;" FontSize="15" Foreground="{DynamicResource Fg}" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="Previous_Click" ToolTip="Önceki şarkı">
                                        <Path Style="{StaticResource Glyph}" Data="M20,1 L20,13 L11,7 Z M10,1 L10,13 L1,7 Z" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="PlayPause_Click">
                                        <Grid Width="18" Height="20">
                                            <Path x:Name="HomePlayIcon" Style="{StaticResource Glyph}" Data="M2,1 L2,19 L16,10 Z" />
                                            <Path x:Name="HomePauseIcon" Style="{StaticResource Glyph}" Visibility="Collapsed" Data="M2,1 H6 V19 H2 Z M12,1 H16 V19 H12 Z" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Click="Next_Click">
                                        <Path Style="{StaticResource Glyph}" Data="M1,1 L1,13 L10,7 Z M11,1 L11,13 L20,7 Z" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Timer -->
                        <Border x:Name="HomeTimerCard" Style="{StaticResource HomeCard}" Cursor="Hand" MouseLeftButtonUp="HomeTimer_Click">
                            <Grid>
                                <Grid Width="22" Height="22" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Viewbox>
                                        <Grid Width="20" Height="20">
                                            <Ellipse Stroke="{StaticResource OrangeDim}" StrokeThickness="2.5" />
                                            <Path x:Name="HomeTimerRing" Stroke="{StaticResource Orange}" StrokeThickness="2.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                                <TextBlock x:Name="HomeTimerLabel" FontSize="13" Foreground="{DynamicResource Fg}"
                                           VerticalAlignment="Center" Margin="38,0,0,0" />
                                <TextBlock x:Name="HomeTimerText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Orange}"
                                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                            </Grid>
                        </Border>

                        <!-- Download -->
                        <Border x:Name="HomeDownloadCard" Style="{StaticResource HomeCard}" Cursor="Hand" MouseLeftButtonUp="HomeDownload_Click">
                            <Grid>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="16" Foreground="{StaticResource Blue}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0" />
                                <TextBlock x:Name="HomeDownloadName" FontSize="13" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="38,0,130,0" />
                                <TextBlock x:Name="HomeDownloadDetail" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                            </Grid>
                        </Border>

                        <!-- Discord -->
                        <Border x:Name="HomeDiscordCard" Style="{StaticResource HomeCard}" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonUp="HomeDiscord_Click">
                            <Grid>
                                <Border x:Name="HomeDiscordIcon" Width="26" Height="26" CornerRadius="8" Background="#5865F2" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE95B;" FontSize="14" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Discord" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                           VerticalAlignment="Center" Margin="38,0,0,0" />
                                <TextBlock x:Name="HomeDiscordDetail" FontSize="12" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="100,0,6,0" />
                            </Grid>
                        </Border>

                        <!-- Weather and calendar side by side -->
                        <Grid x:Name="HomeWidgets" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HomeWeatherCard" Style="{StaticResource HomeCard}" Margin="0" Padding="13,9" Cursor="Hand" MouseLeftButtonUp="HomeWeather_Click">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="HomeWeatherCity" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,1" />
                                        <TextBlock x:Name="HomeWeatherTemp" FontSize="24" FontWeight="Light" Foreground="{DynamicResource Accent}" />
                                        <TextBlock x:Name="HomeWeatherSky" FontSize="11.5" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock x:Name="HomeWeatherRange" FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                            <Border x:Name="HomeCalendarCard" Grid.Column="2" Style="{StaticResource HomeCard}" Margin="0" Padding="13,9" Cursor="Hand" MouseLeftButtonUp="HomeCalendar_Click">
                                <StackPanel>
                                    <TextBlock x:Name="HomeCalendarDay" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,3" />
                                    <TextBlock x:Name="HomeCalendarTime" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                    <TextBlock x:Name="HomeCalendarTitle" FontSize="11.5" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Most used apps, from Windows' own usage record -->
                        <Border x:Name="HomeAppsCard" Style="{StaticResource HomeCard}" Padding="6,9,6,5" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="En çok kullanılanlar" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="8,0,0,2" />
                                <UniformGrid x:Name="HomeApps" Rows="1" Columns="5" />
                            </StackPanel>
                        </Border>

                        <!-- Shortcuts -->
                        <UniformGrid x:Name="HomeTiles" Rows="1" Margin="0,2,0,0">
                            <Button Style="{StaticResource IconButton}" x:Name="TileTimer" Click="HomeTimerTile_Click">
                                <StackPanel Width="58">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#FF9F0A">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE916;" FontSize="18" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Sayaç" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" x:Name="TileInbox" Click="HomeInbox_Click">
                                <StackPanel Width="58">
                                    <Grid Width="42" Height="42">
                                        <Border CornerRadius="12" Background="#FF375F">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA8F;" FontSize="18" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="HomeInboxBadge" MinWidth="16" Height="16" CornerRadius="8" Background="#FF3B30" Padding="4,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Visibility="Collapsed"
                                                BorderBrush="{DynamicResource IslandBg}" BorderThickness="1">
                                            <TextBlock x:Name="HomeInboxCount" FontSize="9.5" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Bildirim" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" x:Name="TileFavorites" Click="HomeFavorites_Click">
                                <StackPanel Width="58">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#FF2D55">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE00B;" FontSize="18" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Beğeniler" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" x:Name="TileClipboard" Click="HomeClipboard_Click">
                                <StackPanel Width="58">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#5E5CE6">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="18" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Pano" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" x:Name="TileShelf" Click="HomeShelf_Click">
                                <StackPanel Width="58">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#0A84FF">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="18" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Raf" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="HomeSettings_Click">
                                <StackPanel Width="58">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#636366">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="18" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Ayarlar" FontSize="11" Foreground="{DynamicResource Fg}" TextAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Timer lengths, replacing the shortcuts for a moment -->
                        <StackPanel x:Name="HomeChips" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,10" Visibility="Collapsed">
                            <Button Style="{StaticResource IconButton}" Click="HomeChipsBack_Click" ToolTip="Geri">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" FontSize="13" Foreground="{DynamicResource SecondaryText}" />
                            </Button>
                            <Button Style="{StaticResource HomeChip}" Tag="1" Content="1 dk" Click="StartTimer_Click" />
                            <Button Style="{StaticResource HomeChip}" Tag="5" Content="5 dk" Click="StartTimer_Click" />
                            <Button Style="{StaticResource HomeChip}" Tag="10" Content="10 dk" Click="StartTimer_Click" />
                            <Button Style="{StaticResource HomeChip}" Tag="15" Content="15 dk" Click="StartTimer_Click" />
                            <Button Style="{StaticResource HomeChip}" Tag="25" Content="25 dk" Click="StartTimer_Click" />
                            <Button Style="{StaticResource HomeChip}" Tag="60" Content="1 sa" Click="StartTimer_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Discord voice channel -->
                <Grid x:Name="DiscordPanel" Width="300" Height="37" Opacity="0" IsHitTestVisible="False">
                    <Border x:Name="DiscordPillIcon" Width="23" Height="23" CornerRadius="7" Background="#5865F2" HorizontalAlignment="Left" Margin="8,0,0,0">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE95B;" FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Sesli kanalda" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                               VerticalAlignment="Center" Margin="40,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse x:Name="DiscordDot" Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="DiscordState" FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Notification list -->
                <Grid x:Name="InboxPanel" Width="400" Height="150" Opacity="0" IsHitTestVisible="False">
                    <StackPanel x:Name="InboxContent" VerticalAlignment="Top" Margin="18,14,18,12">
                        <Button Style="{StaticResource BackLink}" Click="Back_Click" Margin="4,0,0,8" />
                        <Grid Margin="2,0,2,10">
                            <TextBlock Text="Bildirimler" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="InboxQuiet" Style="{StaticResource LinkButton}" Click="InboxQuiet_Click" Margin="0,0,14,0" />
                                <Button Style="{StaticResource LinkButton}" Content="Temizle" Click="InboxClear_Click" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="InboxList" />
                    </StackPanel>
                </Grid>

                <!-- Calendar: month view, the chosen day's events, add an event -->
                <Grid x:Name="CalendarPanel" Width="400" Height="400" Opacity="0" IsHitTestVisible="False">
                    <StackPanel x:Name="CalendarContent" VerticalAlignment="Top" Margin="18,14,18,14">
                        <Button Style="{StaticResource BackLink}" Click="Back_Click" Margin="4,0,0,6" />
                        <Grid Margin="2,0,2,6">
                            <TextBlock x:Name="CalendarMonth" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Click="CalendarPrev_Click">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76B;" FontSize="11" Foreground="{DynamicResource Fg}" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="CalendarNext_Click">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="11" Foreground="{DynamicResource Fg}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <UniformGrid x:Name="CalendarWeekdays" Columns="7" />
                        <UniformGrid x:Name="CalendarDays" Columns="7" />
                        <TextBlock x:Name="CalendarDayTitle" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="4,10,0,6" />
                        <StackPanel x:Name="CalendarEvents" />
                        <Border CornerRadius="12" Background="{DynamicResource ClipBg}" Padding="12,7" Margin="0,4,0,0">
                            <Grid>
                                <TextBox x:Name="CalendarInput" Style="{StaticResource PlainInput}" FontSize="13"
                                         KeyDown="CalendarInput_KeyDown" TextChanged="CalendarInput_TextChanged" />
                                <TextBlock x:Name="CalendarHint" Text="14:30 Toplantı yaz, Enter'a bas" FontSize="13" IsHitTestVisible="False"
                                           Foreground="{DynamicResource SecondaryText}" Margin="2,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
                <!-- Discord card -->
                <Grid x:Name="DiscordCard" Width="400" Height="200" Opacity="0" IsHitTestVisible="False">
                    <StackPanel x:Name="DiscordCardContent" VerticalAlignment="Top" Margin="16,14,16,10">
                        <Button Style="{StaticResource BackLink}" Click="Back_Click" Margin="6,0,0,10" />
                        <Grid Margin="2,0,2,12">
                            <Border x:Name="DiscordCardIcon" Width="40" Height="40" CornerRadius="11" Background="#5865F2" HorizontalAlignment="Left">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE95B;" FontSize="20" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="50,0,70,0" VerticalAlignment="Center">
                                <TextBlock Text="Discord" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                <TextBlock x:Name="DiscordCardStatus" FontSize="12" Foreground="{DynamicResource SecondaryText}" />
                            </StackPanel>
                            <Button Style="{StaticResource HomeChip}" Content="Aç" Click="DiscordOpen_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border x:Name="DiscordCallRow" Style="{StaticResource HomeCard}" Padding="14,10" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Sesli kanalda" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                                    <TextBlock x:Name="DiscordCallTime" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                               Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Height="5" Margin="0,8,0,5">
                                    <Border Background="{DynamicResource TrackBrush}" CornerRadius="2.5" />
                                    <Border x:Name="DiscordLevel" Width="0" HorizontalAlignment="Left" Background="{StaticResource Green}" CornerRadius="2.5" />
                                </Grid>
                                <TextBlock x:Name="DiscordCallState" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="DiscordUsage" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="4,0,0,9" />
                        <StackPanel x:Name="DiscordMessages" />
                    </StackPanel>
                </Grid>

                <!-- Five day weather forecast -->
                <Grid x:Name="ForecastPanel" Width="400" Height="200" Opacity="0" IsHitTestVisible="False">
                    <StackPanel x:Name="ForecastContent" VerticalAlignment="Top" Margin="20,14,20,10">
                        <Button Style="{StaticResource BackLink}" Click="Back_Click" Margin="2,0,0,8" />
                        <TextBlock x:Name="ForecastTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" Margin="2,0,0,12" />
                        <StackPanel x:Name="ForecastRows" />
                    </StackPanel>
                </Grid>

                <!-- Liked songs -->
                <Grid x:Name="FavoritesPanel" Width="400" Height="150" Opacity="0" IsHitTestVisible="False">
                    <StackPanel x:Name="FavoritesContent" VerticalAlignment="Top" Margin="18,14,18,12">
                        <Button Style="{StaticResource BackLink}" Click="Back_Click" Margin="4,0,0,8" />
                        <Grid Margin="2,0,2,10">
                            <TextBlock Text="Beğenilen şarkılar" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" />
                            <TextBlock x:Name="FavoritesCount" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="FavoritesList" />
                    </StackPanel>
                </Grid>

            </Canvas>
        </Border>
    </Grid>
</Window>
